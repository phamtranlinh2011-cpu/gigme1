rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Test connection endpoint
    match /test/connection {
      allow read: if true;
      allow write: if true;
    }

    // User profiles: Only self or admin can update; transactions and role cannot be forged
    match /users/{userId} {
      allow read: if true;
      allow create: if true; // Allows initial signup & sync
      allow update: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == 'deffqsqw@gmail.com')
                    || (request.resource.data.role == resource.data.role); // Prevent privilege escalation to ADMIN
      allow delete: if false; // User accounts are retained for audit & escrow disputes
    }

    // Gigs & jobs: Realtime job board
    match /gigs/{gigId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.clientId || request.auth.token.email == 'deffqsqw@gmail.com');

      // Subcollection for chat messages within a gig
      match /messages/{messageId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false; // Message logs are immutable
      }
    }

    // Global chat messages
    match /messages/{messageId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Financial ledger / Transactions: strictly append-only (No update, No delete)
    match /transactions/{transactionId} {
      allow read: if true;
      allow create: if true;
      allow update: if false; // Financial records are immutable
      allow delete: if false; // Financial audit logs cannot be erased
    }

    // Campus Marketplace
    match /marketplace/{itemId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Bids & job applications
    match /bids/{bidId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // SafeWalk sessions
    match /safewalk/{sessionId} {
      allow read, write: if true;
    }

    // Global System Settings & Maintenance Mode
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

