rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@admin.vn' ||
        request.auth.token.email == 'vnlandserver@gmail.com' ||
        request.auth.uid == '000000000'
      );
    }

    // Test connection endpoint
    match /test/connection {
      allow read: if true;
      allow write: if true;
    }

    // User profiles: trustScore cannot exceed 100, role escalation prevented, root admin protected
    match /users/{userId} {
      allow read: if true;
      allow create: if (!('trustScore' in request.resource.data) || request.resource.data.trustScore <= 100);
      allow update: if (!('trustScore' in request.resource.data) || request.resource.data.trustScore <= 100)
                    && (isAdmin() || request.resource.data.role == resource.data.role || request.resource.data.role != 'ADMIN');
      allow delete: if userId != '000000000';
    }

    // Gigs & jobs: Realtime job board
    match /gigs/{gigId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.clientId || isAdmin()) || true;

      // Subcollection for chat messages within a gig
      match /messages/{messageId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false; // Message logs are immutable
      }
    }

    // Global chat messages
    match /messages/{messageId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Financial ledger / Transactions: strictly append-only (No update, No delete)
    match /transactions/{transactionId} {
      allow read: if true;
      allow create: if true;
      allow update: if false; // Financial records are immutable
      allow delete: if false; // Financial audit logs cannot be erased
    }

    // Campus Marketplace
    match /marketplace/{itemId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Bids & job applications
    match /bids/{bidId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // SafeWalk sessions
    match /safewalk/{sessionId} {
      allow read, write: if true;
    }

    // Global System Settings & Maintenance Mode
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

