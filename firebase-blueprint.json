{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in GigMe campus platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["USER", "ADMIN", "MOD"] },
        "studentSchool": { "type": "string", "maxLength": 150 },
        "studentId": { "type": "string", "maxLength": 50 },
        "walletBalance": { "type": "number" },
        "escrowLockedBalance": { "type": "number" },
        "trustScore": { "type": "number" },
        "rating": { "type": "number" },
        "avatarUrl": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "name", "email"]
    },
    "Gig": {
      "title": "Gig",
      "description": "Micro-job posting on campus with Smart Escrow",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 3000 },
        "category": { "type": "string", "maxLength": 50 },
        "price": { "type": "number" },
        "locationName": { "type": "string", "maxLength": 200 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "clientId": { "type": "string", "maxLength": 100 },
        "clientName": { "type": "string", "maxLength": 100 },
        "freelancerId": { "type": "string", "maxLength": 100 },
        "freelancerName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["OPEN", "IN_PROGRESS", "SUBMITTED", "COMPLETED", "DISPUTED", "CLIENT_REFUNDED"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "price", "clientId", "status"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time communication message inside a gig workspace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gigId": { "type": "string", "maxLength": 100 },
        "senderId": { "type": "string", "maxLength": 100 },
        "senderName": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 2000 },
        "attachmentType": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "gigId", "senderId", "message", "timestamp"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Financial ledger record for VietQR deposits, Escrow hold, and payouts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "timestamp": { "type": "number" },
        "isSuccess": { "type": "boolean" }
      },
      "required": ["id", "userId", "type", "amount", "timestamp"]
    },
    "MarketplaceItem": {
      "title": "MarketplaceItem",
      "description": "Flea market used textbooks and campus housing items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 50 },
        "price": { "type": "number" },
        "condition": { "type": "string", "maxLength": 50 },
        "schoolName": { "type": "string", "maxLength": 150 },
        "sellerId": { "type": "string", "maxLength": 100 },
        "sellerName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["AVAILABLE", "RESERVED", "SOLD"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "price", "sellerId", "status"]
    },
    "Bid": {
      "title": "Bid",
      "description": "Reverse auction proposal submitted by campus workers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gigId": { "type": "string", "maxLength": 100 },
        "freelancerId": { "type": "string", "maxLength": 100 },
        "freelancerName": { "type": "string", "maxLength": 100 },
        "offeredPrice": { "type": "number" },
        "estimatedMinutes": { "type": "number" },
        "proposalNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "gigId", "freelancerId", "offeredPrice", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time notification for new gigs and status updates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "enum": ["NEW_GIG", "STATUS_UPDATE", "INFO"] },
        "gigId": { "type": "string", "maxLength": 100 },
        "gigTitle": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "message", "type", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "WalletTransaction",
      "description": "User individual sub-collection transactions"
    },
    "/gigs/{gigId}": {
      "schema": "Gig",
      "description": "Gigs job postings collection"
    },
    "/gigs/{gigId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Chat messages within a gig"
    },
    "/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Global direct and support chat messages"
    },
    "/transactions/{transactionId}": {
      "schema": "WalletTransaction",
      "description": "User wallet transaction histories"
    },
    "/marketplace/{itemId}": {
      "schema": "MarketplaceItem",
      "description": "Campus flea market second-hand listings"
    },
    "/bids/{bidId}": {
      "schema": "Bid",
      "description": "Job bids and proposals"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Real-time notifications collection for new gigs and status updates"
    }
  }
}
